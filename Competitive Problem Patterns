import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        int T = Integer.parseInt(br.readLine().trim());
        StringBuilder output = new StringBuilder();

        while (T-- > 0) {
            String s = br.readLine().trim();
            int n = s.length();

            int[] freq = new int[26];

            // First half
            for (int i = 0; i < n / 2; i++) {
                freq[s.charAt(i) - 'a']++;
            }

            // Second half (skip middle character automatically for odd length)
            for (int i = (n + 1) / 2; i < n; i++) {
                freq[s.charAt(i) - 'a']--;
            }

            boolean isLapindrome = true;

            for (int count : freq) {
                if (count != 0) {
                    isLapindrome = false;
                    break;
                }
            }

            output.append(isLapindrome ? "YES\n" : "NO\n");
        }

        System.out.print(output);
    }
}
